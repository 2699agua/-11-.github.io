<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>登录界面 · 极简风格</title>
  <!-- 使用 Google Material Icons 提升视觉 -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0,1" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(145deg, #f5f7fe 0%, #e9eefa 100%);
      padding: 16px;
    }

    /* 主卡片 */
    .login-card {
      width: 100%;
      max-width: 400px;
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-radius: 36px;
      padding: 40px 32px 36px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25), 0 8px 20px -8px rgba(0, 20, 40, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.6);
      transition: all 0.2s ease;
    }

    /* 标题区域 */
    .login-header {
      text-align: center;
      margin-bottom: 32px;
    }

    .login-header .logo {
      width: 64px;
      height: 64px;
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      box-shadow: 0 12px 18px -8px rgba(26, 67, 113, 0.4);
    }

    .login-header .logo span {
      font-size: 36px;
      color: white;
      font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 32;
    }

    .login-header h1 {
      font-size: 28px;
      font-weight: 600;
      letter-spacing: -0.5px;
      color: #0e1e3e;
      margin-bottom: 6px;
    }

    .login-header p {
      font-size: 15px;
      color: #5d6b8c;
      font-weight: 400;
    }

    /* 表单 */
    .login-form {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .input-group label {
      font-size: 14px;
      font-weight: 500;
      color: #1f2a4a;
      padding-left: 6px;
      letter-spacing: 0.3px;
    }

    .input-field {
      display: flex;
      align-items: center;
      background: #ffffff;
      border-radius: 20px;
      padding: 0 18px;
      border: 1.5px solid #d9e1f0;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
    }

    .input-field:focus-within {
      border-color: #2a5298;
      box-shadow: 0 0 0 4px rgba(42, 82, 152, 0.12);
    }

    .input-field span.material-symbols-outlined {
      font-size: 22px;
      color: #7b8aa8;
      font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
      transition: color 0.2s;
    }

    .input-field:focus-within span.material-symbols-outlined {
      color: #2a5298;
    }

    .input-field input {
      flex: 1;
      border: none;
      outline: none;
      padding: 16px 12px;
      font-size: 16px;
      background: transparent;
      color: #0d1b33;
      font-weight: 400;
      letter-spacing: 0.2px;
    }

    .input-field input::placeholder {
      color: #a8b6d0;
      font-weight: 300;
      font-size: 15px;
    }

    /* 忘记密码 & 辅助选项 */
    .form-options {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin: 2px 0 4px;
      padding: 0 4px;
    }

    .remember {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 14px;
      color: #31456b;
      cursor: pointer;
      user-select: none;
    }

    .remember input[type="checkbox"] {
      width: 17px;
      height: 17px;
      accent-color: #1e3c72;
      border-radius: 5px;
      cursor: pointer;
    }

    .forgot-link {
      font-size: 14px;
      color: #2a5298;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.2s;
      border-bottom: 1px solid transparent;
    }

    .forgot-link:hover {
      color: #0f2b5c;
      border-bottom-color: #0f2b5c;
    }

    /* 登录按钮 */
    .login-btn {
      margin-top: 8px;
      background: linear-gradient(145deg, #1e3c72, #16305c);
      border: none;
      border-radius: 30px;
      padding: 16px;
      color: white;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: 0.5px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 12px 18px -10px #1e3c72a0, 0 6px 12px -6px #1e3c7250;
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .login-btn:hover {
      background: linear-gradient(145deg, #16305c, #10274d);
      transform: translateY(-1px);
      box-shadow: 0 18px 25px -12px #1e3c72b0, 0 8px 16px -8px #1e3c7270;
    }

    .login-btn:active {
      transform: translateY(1px);
      box-shadow: 0 6px 12px -6px #1e3c72a0;
    }

    .login-btn span {
      font-size: 22px;
      font-variation-settings: 'FILL' 0, 'wght' 500, 'GRAD' 0, 'opsz' 24;
    }

    /* 分隔线 */
    .divider {
      display: flex;
      align-items: center;
      text-align: center;
      margin: 24px 0 20px;
      color: #8f9fc0;
      font-size: 14px;
      font-weight: 400;
      gap: 14px;
    }

    .divider::before,
    .divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(to right, transparent, #cdd9ec, transparent);
    }

    /* 第三方登录 */
    .social-login {
      display: flex;
      justify-content: center;
      gap: 18px;
      margin-bottom: 8px;
    }

    .social-btn {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      background: #ffffff;
      border: 1.5px solid #e2e9f5;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
      color: #3c4f72;
      box-shadow: 0 6px 12px -6px rgba(0, 0, 0, 0.08);
    }

    .social-btn:hover {
      background: #f6faff;
      border-color: #b8caec;
      transform: scale(1.03);
      color: #1e3c72;
      box-shadow: 0 10px 18px -8px rgba(30, 60, 114, 0.2);
    }

    .social-btn span {
      font-size: 26px;
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    /* 注册引导 */
    .register-section {
      text-align: center;
      margin-top: 24px;
      font-size: 15px;
      color: #405472;
    }

    .register-section a {
      color: #1e3c72;
      font-weight: 600;
      text-decoration: none;
      margin-left: 6px;
      border-bottom: 1.5px solid transparent;
      transition: border-color 0.2s;
    }

    .register-section a:hover {
      border-bottom-color: #1e3c72;
    }

    /* 错误提示小样式 (仅视觉) */
    .input-field.error {
      border-color: #e53e3e;
      background: #fff8f8;
    }

    /* 移动端微调 */
    @media (max-width: 440px) {
      .login-card {
        padding: 32px 22px 28px;
        border-radius: 28px;
      }
      .login-header h1 {
        font-size: 24px;
      }
      .social-btn {
        width: 48px;
        height: 48px;
      }
    }
  </style>
</head>
<body>
  <div class="login-card">
    <!-- 头部 Logo 和标题 -->
    <div class="login-header">
      <div class="logo">
        <span class="material-symbols-outlined">lock</span>
      </div>
      <h1>欢迎回来</h1>
      <p>登录你的账户以继续</p>
    </div>

    <!-- 登录表单 -->
    <form class="login-form" action="#" method="POST" onsubmit="event.preventDefault(); alert('登录演示 · 无实际提交\n邮箱和密码已输入');">
      <!-- 邮箱输入 -->
      <div class="input-group">
        <label for="email">邮箱</label>
        <div class="input-field">
          <span class="material-symbols-outlined">mail</span>
          <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email">
        </div>
      </div>

      <!-- 密码输入 -->
      <div class="input-group">
        <label for="password">密码</label>
        <div class="input-field">
          <span class="material-symbols-outlined">lock</span>
          <input type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
      </div>

      <!-- 记住我 / 忘记密码 -->
      <div class="form-options">
        <label class="remember">
          <input type="checkbox" checked> 记住我
        </label>
        <a href="#" class="forgot-link">忘记密码？</a>
      </div>

      <!-- 登录按钮 -->
      <button type="submit" class="login-btn">
        <span class="material-symbols-outlined">login</span>
        登录
      </button>
    </form>

    <!-- 分隔线 -->
    <div class="divider">或</div>

    <!-- 第三方登录图标 (纯视觉演示) -->
    <div class="social-login">
      <div class="social-btn" title="使用 Google 登录">
        <span class="material-symbols-outlined">g_translate</span>
      </div>
      <div class="social-btn" title="使用 GitHub 登录">
        <span class="material-symbols-outlined">code</span>
      </div>
      <div class="social-btn" title="使用 Apple 登录">
        <span class="material-symbols-outlined">phone_iphone</span>
      </div>
    </div>

    <!-- 注册链接 -->
    <div class="register-section">
      还没有账户？<a href="#">立即注册</a>
    </div>
  </div>

  <!-- 一个小脚本：点击社交按钮仅做反馈 (演示用) -->
  <script>
    (function() {
      const socialBtns = document.querySelectorAll('.social-btn');
      socialBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          const title = btn.getAttribute('title') || '第三方';
          alert(`${title} 登录演示 (无实际跳转)`);
        });
      });

      // 可选：演示密码显隐切换 (但默认没有眼睛图标，这里不加，保持干净)
      // 如果需要显示/隐藏密码可以添加，但为了简洁就不加了。
    })();
  </script>
</body>
</html>
